{
  "name": "bestskills",
  "version": "1.0.0",
  "description": "Scan projects and recommend agent skills from the registry",
  "type": "module",
  "scripts": {
    "dev": "bun bin/bestskills.js",
    "start": "bun bin/bestskills.js",
    "build": "scripts/build-release.sh",
    "build:dev": "bun build ./bin/bestskills.js --compile --outfile=dist/bestskills",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.4.0",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}